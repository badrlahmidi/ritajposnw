# ═══════════════════════════════════════════════════════════
#  RITAJ SMART POS — Variables d'environnement
#  Copiez ce fichier en .env et adaptez les valeurs
# ═══════════════════════════════════════════════════════════

# Serveur
PORT=3000
BASE_PATH=/pos

# Sécurité JWT — OBLIGATOIRE en production.
# - Doit faire au moins 32 caractères.
# - Ne doit PAS contenir les mots: default, CHANGE, example, secret.
# - En développement, laissez vide : une clé 64 octets sera générée automatiquement
#   dans .env au premier démarrage (permissions 0600).
# - En production (NODE_ENV=production), le serveur REFUSE de démarrer si la clé
#   est absente, trop courte, ou contient un marqueur de clé par défaut.
# Générez-en une via : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES=12h

# CORS — origines autorisées (séparées par des virgules, vide = même origine)
CORS_ORIGINS=

# Identité produit
APP_NAME=RITAJ SMART POS
APP_VERSION=4.1.0
