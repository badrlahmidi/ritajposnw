# Ritaj Smart POS — Variables d'environnement
# Voir docs/superpowers/specs/2026-08-19-deep-audit-fixes-refactoring-design.md

# Intervalles et temporisations
BACKUP_INTERVAL_MS=18000000  # 5 heures en millisecondes (ancienne valeur: 4 * 60 * 60 * 1000)
RATE_LIMIT_MAX=100
UPLOAD_MAX_SIZE=10mb
SESSION_TIMEOUT_MS=3600000  # 1 heure

# Configuration de l'application
NODE_ENV=development
JWT_SECRET=change-this-secret-in-production
CLIENT_URL=http://localhost:3000